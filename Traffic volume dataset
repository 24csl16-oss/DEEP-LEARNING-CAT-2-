    {
      "cell_type": "code",
      "source": [
        "# Select numerical input features\n",
        "feature_cols = [\n",
        "    \"traffic_volume\",\n",
        "    \"hour_sin\", \"hour_cos\",\n",
        "    \"day_sin\", \"day_cos\",\n",
        "    \"is_weekend\"\n",
        "] + weather_cols\n",
        "\n",
        "if \"is_holiday\" in traffic.columns:\n",
        "    feature_cols.append(\"is_holiday\")\n",
        "\n",
        "data = traffic[feature_cols].astype(float).copy()\n",
        "target = traffic[\"traffic_volume\"].astype(float).copy()\n",
        "\n",
        "# Chronological 80% training, 20% testing\n",
        "split = int(len(data) * 0.80)\n",
        "\n",
        "# Fit scalers ONLY on training data\n",
        "x_scaler = StandardScaler()\n",
        "y_scaler = StandardScaler()\n",
        "\n",
        "x_scaler.fit(data.iloc[:split])\n",
        "y_scaler.fit(target.iloc[:split].to_numpy().reshape(-1, 1))\n",
        "\n",
        "X_scaled = x_scaler.transform(data)\n",
        "y_scaled = y_scaler.transform(\n",
        "    target.to_numpy().reshape(-1, 1)\n",
        ").ravel()\n",
        "\n",
        "# Create 24-hour input windows\n",
        "window_size = 24\n",
        "X, y, target_indices = [], [], []\n",
        "\n",
        "for i in range(window_size, len(data)):\n",
        "    X.append(X_scaled[i-window_size:i])\n",
        "    y.append(y_scaled[i])\n",
        "    target_indices.append(i)\n",
        "\n",
        "X = np.array(X, dtype=np.float32)\n",
        "y = np.array(y, dtype=np.float32)\n",
        "target_indices = np.array(target_indices)\n",
        "\n",
        "# Split windows according to their target timestamp\n",
        "train_mask = target_indices < split\n",
        "test_mask = target_indices >= split\n",
        "\n",
        "X_train, y_train = X[train_mask], y[train_mask]\n",
        "X_test, y_test = X[test_mask], y[test_mask]\n",
        "\n",
        "print(\"Training windows:\", X_train.shape)\n",
        "print(\"Testing windows:\", X_test.shape)\n",
        "print(\"Input shape:\", X_train.shape[1:])"
      ],

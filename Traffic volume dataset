        ")\n",
        "\n",
        "traffic[\"day_sin\"] = np.sin(\n",
        "    2 * np.pi * traffic[\"day_of_week\"] / 7\n",
        ")\n",
        "traffic[\"day_cos\"] = np.cos(\n",
        "    2 * np.pi * traffic[\"day_of_week\"] / 7\n",
        ")\n",
        "\n",
        "# Fill missing weather measurements within this segment\n",
        "weather_cols = [\n",
        "    col for col in\n",
        "    [\"temp\", \"rain_1h\", \"snow_1h\", \"clouds_all\"]\n",
        "    if col in traffic.columns\n",
        "]\n",
        "\n",
        "traffic[weather_cols] = traffic[weather_cols].ffill().bfill()\n",
        "\n",
        "# Convert holiday indicator to numeric\n",
        "if \"holiday\" in traffic.columns:\n",
        "    traffic[\"is_holiday\"] = (\n",

        "# Reindex to a complete hourly timeline\n",
        "df = df.asfreq(\"h\")\n",
        "\n",
        "# Interpolate missing values to handle gaps and get a continuous timeline\n",
        "df[\"traffic_volume\"] = df[\"traffic_volume\"].interpolate(method=\"linear\")\n",
        "df[\"temp\"] = df[\"temp\"].interpolate(method=\"linear\")\n",
        "df[\"rain_1h\"] = df[\"rain_1h\"].fillna(0.0)\n",
        "df[\"snow_1h\"] = df[\"snow_1h\"].fillna(0.0)\n",
        "df[\"clouds_all\"] = df[\"clouds_all\"].interpolate(method=\"linear\")\n",
        "\n",
        "# Select a continuous block of 5000 hours\n",
        "traffic = df.iloc[:5000].copy()\n",
        "\n",
        "# Verify every timestamp is exactly one hour apart and has no NaNs in traffic_volume\n",
        "assert traffic[\"traffic_volume\"].notna().all(), \"Still contains NaN values\"\n",
        "assert (traffic.index.to_series().diff().dropna() == pd.Timedelta(hours=1)).all()\n",
        "\n",
        "print(\"Continuous hourly records:\", len(traffic))\n",
        "print(\"Start:\", traffic.index.min())\n",
